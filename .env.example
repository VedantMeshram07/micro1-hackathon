# Copy this file to .env and fill in your own values. Never commit .env.

ANTHROPIC_API_KEY=

# Check https://docs.claude.com for the current model IDs before running —
# this is just a placeholder, don't assume it's still current.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional but recommended: raises GitHub API rate limits for PR/issue mining.
# Create a fine-grained read-only token, no special scopes needed for public repos.
GITHUB_TOKEN=

# Safety switch for the hosted demo. Keep False on any public deployment —
# only flip True for local/private runs. See README "Security note".
ENABLE_LIVE_INGEST=False
