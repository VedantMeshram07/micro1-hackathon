# Copy this file to .env and fill in your own values. Never commit .env.

# Which provider powers the pipeline's LLM calls: "anthropic" or "gemini"
LLM_PROVIDER=anthropic

# Needed if LLM_PROVIDER=anthropic. Check https://docs.claude.com for
# current model IDs before running — this is just a placeholder.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Needed if LLM_PROVIDER=gemini. Get a free key at https://aistudio.google.com
# On the free tier, use Flash or Flash-Lite — Pro's free quota is too tight
# for this pipeline's ~7 calls/repo. Check ai.google.dev for current limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended: raises GitHub API rate limits for PR/issue mining.
# Create a classic token with NO scopes checked — read-only public data
# doesn't need any permissions, the token just raises your rate limit.
GITHUB_TOKEN=

# Safety switch for the hosted demo. Keep False on any public deployment —
# only flip True for local/private runs. See README "Security note".
ENABLE_LIVE_INGEST=False
